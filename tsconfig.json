{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/env.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "gsap": ["node_modules/gsap/types/index.d.ts"],
      "gsap/ScrollTrigger": ["node_modules/gsap/types/scroll-trigger.d.ts"],
      "gsap/*": ["node_modules/gsap/types/*"]
    }
  }
}